# ---------------------------------------------------------------------------
# PrimeKortingscode — environment template
# Copy to `.env.local` (never commit `.env.local`).
# All future backend/API configuration is centralized here so no API URL or
# secret is ever hardcoded inside components or services.
# ---------------------------------------------------------------------------

# Public canonical origin of the website. Used for canonical URLs, hreflang,
# Open Graph, sitemap and robots output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Future backend (NOT implemented yet — frontend runs on local mock data).
# When WordPress/the API goes live, services read the base URL from here and
# nothing else in the codebase needs to change.
# ---------------------------------------------------------------------------
# API_BASE_URL=https://example.com/wp-json/prime-kortingscode/v1
# API_TOKEN=

# Revalidation secret used by on-demand ISR/webhook revalidation later.
# REVALIDATE_SECRET=
