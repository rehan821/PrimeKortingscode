{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://primekortingscode.nl/schemas/coupon.schema.json",
  "title": "Coupon",
  "description": "A discount code ('kortingscode'). Deal-type entries are described by deal.schema.json but share this shape via the `type` discriminator.",
  "type": "object",
  "required": [
    "id", "slug", "title", "type", "storeId", "categoryIds",
    "redirectUrl", "isVerified", "isFeatured", "createdAt", "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "code": {
      "type": ["string", "null"],
      "description": "Discount code revealed in the coupon modal. Optional: may be withheld in list responses."
    },
    "type": { "type": "string", "enum": ["coupon", "deal"] },
    "storeId": { "type": "string", "minLength": 1 },
    "categoryIds": { "type": "array", "items": { "type": "string" } },
    "redirectUrl": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Affiliate/store destination. Data-driven only — never hardcoded in UI. Backend must validate against a domain allowlist."
    },
    "isVerified": { "type": "boolean" },
    "isFeatured": { "type": "boolean" },
    "discountLabel": {
      "type": "string",
      "description": "Human-readable headline such as '20% korting'."
    },
    "termsAndConditions": { "type": "string" },
    "usageCount": { "type": "integer", "minimum": 0 },
    "startsAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
