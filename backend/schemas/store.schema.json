{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://primekortingscode.nl/schemas/store.schema.json",
  "title": "Store",
  "description": "A webshop/store entity. Contract only — mirrors frontend/types Store model.",
  "type": "object",
  "required": ["id", "slug", "name", "description", "websiteUrl", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "websiteUrl": { "type": "string", "pattern": "^https?://" },
    "brandColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Optional brand hint used by the placeholder logo component."
    },
    "initials": {
      "type": "string",
      "maxLength": 4,
      "description": "Optional short letter-mark for the placeholder logo."
    },
    "isFeatured": { "type": "boolean" },
    "activeCouponCount": { "type": "integer", "minimum": 0 },
    "activeDealCount": { "type": "integer", "minimum": 0 },
    "popularity": { "type": "integer", "minimum": 0, "description": "Relative sort weight, higher = more popular." },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
