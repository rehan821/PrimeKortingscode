{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://primekortingscode.nl/schemas/category.schema.json",
  "title": "Category",
  "description": "Content category used to group stores, coupons and deals.",
  "type": "object",
  "required": ["id", "slug", "name", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "icon": {
      "type": "string",
      "description": "Key of a built-in inline SVG icon (no icon library dependency)."
    },
    "parentId": {
      "type": ["string", "null"],
      "description": "Optional parent category for a two-level taxonomy."
    },
    "isFeatured": { "type": "boolean" },
    "storeCount": { "type": "integer", "minimum": 0 },
    "couponCount": { "type": "integer", "minimum": 0 },
    "dealCount": { "type": "integer", "minimum": 0 },
    "popularity": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
